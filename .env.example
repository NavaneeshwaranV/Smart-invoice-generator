# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_invoice_db?retryWrites=true&w=majority
MONGODB_URI=""

# CLERK AUTHENTICATION KEYS
# Obtain these from your Clerk Dashboard -> API Keys (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_JWT_KEY=""

# CORS_ORIGIN: Allowed frontend origin (defaults to *)
CORS_ORIGIN="http://localhost:3000"
